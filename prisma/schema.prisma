// DeGeldHeld — Prisma schema
// Run: pnpm prisma:generate && pnpm prisma:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----- NextAuth core models -----

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // v7 referrals — eigen referral-code voor delen; null tot eerste share
  referralCode  String?   @unique

  // v8 GDPR + email prefs
  notificationsEnabled Boolean  @default(true)
  deletedAt            DateTime?
  ocrTrainingOptIn     Boolean  @default(false)

  // v21 retention engine — anti-spam foundation. Every retention mail
  // respects marketingOptOut + carries an unsubscribe link (token), and
  // the per-type timestamps make the crons idempotent (never mail twice).
  marketingOptOut      Boolean   @default(false)
  unsubscribeToken     String?   @unique
  lastNudgeAt          DateTime?
  lastMonthlyReportAt  DateTime?

  // v11 anti-fraud: account suspend door admin na review.
  // Suspended users kunnen inloggen maar geen nieuwe uploads doen.
  suspendedAt          DateTime?
  suspendedReason      String?

  // v13 subscription plan — optioneel maandabonnement (€4,99/mnd)
  // als alternatief voor de no-cure-no-pay fee. status:
  //   null      → no subscription, fee per verified saving
  //   "active"  → unlimited negotiations included
  //   "past_due"/"canceled" → fee-flow resumes
  subscriptionStatus String?
  subscriptionPlan   String?
  subscriptionRenewsAt DateTime?
  // v18: Stripe identifiers for the DeGeldHeld Plus subscription so
  // the webhook can map customer.subscription.* + invoice.* events
  // back to a user.
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique

  // v19 auto no-cure-no-pay: saved card + recorded mandate consent so the
  // 20% fee can be charged off-session once savings are verified.
  feePaymentMethodId   String?    // Stripe PaymentMethod (pm_...) for fee charge
  feeMandateAcceptedAt DateTime?  // when the no-cure-no-pay mandate was accepted
  feeMandateText       String?    // exact text the user accepted (audit)

  // app data
  accounts      Account[]
  sessions      Session[]
  bills         Bill[]
  negotiations  Negotiation[]
  payments      Payment[]
  waitlistEntry WaitlistEntry?
  referralsCreated Referral[] @relation("ReferralOwner")
  bankConnections  BankConnection[]
  detectedRecurring DetectedRecurring[]
  fraudFlags    FraudFlag[]
  // v30: Box 3 NCNP-claims (proof-back loop) + Plus monthly rescans.
  box3Claims    Box3Claim[]
  plusRescans   PlusRescan[]
  // v35: Claim-Hub uitbreiding — Huurcommissie + Energie-Geschillencommissie.
  // Beide via officiële instanties (geen relay-mail). Drempel € 50, fee 20%.
  huurServicekostenClaims   HuurServicekostenClaim[]
  energieEindafrekeningClaims EnergieEindafrekeningClaim[]
  // v36 idee 4 — document-vault. Eén keer huurcontract/aangifte/etc. uploaden,
  // hergebruiken in elke check/claim.
  documents     UserDocument[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----- App models -----

enum BillCategory {
  TELECOM
  ENERGIE
  WATER
  GEMEENTE
  VERZEKERING
  HYPOTHEEK
  BANK
  ABONNEMENT
  STREAMING
  GYM
  OV
  SOFTWARE
  OPSLAG
  OVERIG
}

enum NegotiationState {
  NIEUW
  BILL_UPLOAD
  ANALYSE
  EMAIL_GEN
  AWAITING
  // v5 multi-round:
  EMAIL_SENT
  RESPONSE_RECEIVED
  COUNTER_SENT
  ACCEPTED
  REJECTED
  // legacy terminals (still used by older negotiations):
  SUCCESS
  FAILED
  BILLED
  // v11 revenue verification:
  SUCCESS_UNVERIFIED       // user claims success without uploading proof
  BILLED_PENDING_PAYMENT   // proof verified, fee invoice waiting on user
  BILLED_OVERDUE           // 14 days passed without payment
  // v19 auto no-cure-no-pay:
  FEE_PAID                 // proof verified + fee charged off-session
}

enum RoundOutcome {
  PENDING
  ACCEPTED
  REJECTED
  ESCALATED
  // v10 auto-pingpong: AI has drafted a counter-mail; user must
  // confirm before it is sent via Resend.
  AWAITING_USER_CONFIRM
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

model Bill {
  id           String       @id @default(cuid())
  // v15: userId is nullable so anonymous visitors can upload before
  // they sign up. Anonymous bills carry an anonymousSessionId cookie
  // value; on magic-link signup the bills are claimed (userId set,
  // anonymousSessionId cleared, claimedAt stamped).
  userId       String?
  anonymousSessionId String?
  // v15.1: cross-browser claim fix — when a visitor submits the
  // email-prompt, we stamp this column on every bill in their
  // anonymous session. The magic-link callback then claims by
  // email match in addition to the cookie, so the link can open
  // in a different browser than the upload happened in.
  anonymousEmail String?
  claimedAt    DateTime?
  provider     String
  category     BillCategory @default(OVERIG)
  amountCents  Int
  // v3.1: split maand-abonnement vs factuur-totaal voor accurate
  // markt-vergelijking. Beide optional voor backwards-compat met
  // bills die voor de migratie zijn aangemaakt.
  monthlyCents Int?
  totalCents   Int?
  plan         String?
  period       String?
  // v3.1: gepar­seerde factuur-periode (1e van de maand UTC).
  // Voor stale-warning op /onderhandel/analyse (>180 dagen oud).
  invoiceDate  DateTime?
  // v4: klantnummer uit OCR — gebruikt in onderhandel-email zodat retentie
  // direct kan zoeken op account.
  customerNumber String?
  // v5: country detected by OCR (NL/BE/DE/FR/UK/US/ES/IT/INT). Used to
  // disambiguate providers and to drive locale + dynamic alternatives.
  country      String?
  // v10 categories-v2: sub-type binnen primaire category (string voor
  // flexibiliteit, geen enum). Bv "stroom+gas", "mobiel", "auto".
  subType      String?
  // v5: currency from valuta-symbol / IBAN-prefix. Default EUR for NL/EU.
  currency     String       @default("EUR")
  // v17: category-specific OCR fields, persisted so the analyse-page
  // can compare against the user's REAL invoice instead of hardcoded
  // market medians. All nullable — only filled when OCR was confident.
  energyKwhRateCents       Int?
  energyM3RateCents        Int?
  energyContractType       String?   // vast/variabel/dynamisch/unknown
  insuranceCoverage        String?   // WA/WA+/CASCO/UNKNOWN
  insuranceDeductibleCents Int?
  mortgageInterestPct      Float?
  mortgageTermYears        Int?
  bankAccountTier          String?
  streamingTier            String?
  imageHash    String?      @unique
  rawOcr       String?      @db.Text
  createdAt    DateTime     @default(now())

  // v6 paywall: position is the 0-indexed rank within this user's bills
  // (first upload = 0 → free, second onwards → paywall). paidAt is set
  // by the /api/webhooks/stripe handler when checkout.session.completed.
  position     Int          @default(0)
  paidAt       DateTime?

  // v8 monthly re-check
  lastRecheckAt    DateTime?
  nextRecheckAt    DateTime?
  lastRecheckMailAt DateTime?
  deletedAt        DateTime?

  // v21 contract-end radar. contractEndDate is detected from OCR or
  // estimated (invoiceDate + 12mo); contractAlertSentAt makes the radar
  // cron idempotent.
  contractEndDate     DateTime?
  contractAlertSentAt DateTime?

  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  negotiation  Negotiation?

  @@index([userId])
  @@index([imageHash])
  @@index([userId, createdAt])
  @@index([anonymousSessionId])
  @@index([anonymousEmail])
}

model Negotiation {
  id              String           @id @default(cuid())
  userId          String
  billId          String           @unique
  state           NegotiationState @default(NIEUW)
  emailSubject    String?
  emailBody       String?          @db.Text
  strategy        String?
  expectedSavingsCents Int?
  actualSavingsCents   Int?
  confidence      Float?
  reasoning       String?          @db.Text
  followUpAt      DateTime?
  emailSentAt     DateTime?
  outcomeAskedAt  DateTime?
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // v7 feedback loop — does the AI mail actually work?
  userRating          Int?      // -1 thumbs-down / 0 neutraal / 1 thumbs-up
  mailUsed            Boolean   @default(false)  // user kopieerde/verstuurde
  providerResponded   Boolean?  // user gaf aan dat provider antwoordde

  // v10 auto-pingpong: email thread tracking voor inbound matching.
  // Resend webhook gebruikt In-Reply-To header om binnenkomende mail
  // aan deze negotiation te koppelen.
  providerThreadId String? @unique

  // v11 revenue verification: user moet bewijs leveren voordat
  // actualSavingsCents als verified telt en de fee getriggerd wordt.
  proofRequired    Boolean   @default(true)
  proofVerifiedAt  DateTime?
  feeInvoicedAt    DateTime?
  feeAmountCents   Int?
  // v19 auto no-cure-no-pay: set when the fee was charged off-session.
  feePaidAt          DateTime?
  feePaymentIntentId String?

  // v23 relay (negotiate-on-behalf). NO relay mail is ever sent without
  // relayAuthorizedAt (consent-first). relayToken routes provider replies
  // back via reply-to onderhandel+<token>@. relayState ∈
  // RELAY_ACTIVE | AWAITING_APPROVAL | PAUSED | DONE.
  relayAuthorizedAt DateTime?
  relayAuthText     String?   @db.Text
  relayToken        String?   @unique
  relayState        String?
  // Loop-guard: how many auto-counters the relay has sent (max enforced
  // in lib/relay.ts). Reset is never needed — terminal states stop sends.
  relayAutoRounds   Int       @default(0)
  // Provider contact address the relay sends to (learned from the inbound
  // reply, or supplied at authorization). Null → relay can't send yet.
  providerEmail     String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bill    Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  payment Payment?
  rounds  NegotiationRound[]
  whatsappThread WhatsAppThread?
  proofs  OutcomeProof[]

  @@index([userId])
  @@index([state])
  @@index([followUpAt])
  // v6 perf: powers the cron follow-up + dashboard "still-waiting" query.
  @@index([state, emailSentAt])
}

// v8 WhatsApp tracking (provider conversation via Twilio/360dialog)
model WhatsAppThread {
  id              String   @id @default(cuid())
  negotiationId   String   @unique
  providerNumber  String
  ourNumber       String
  userPhoneNumber String?
  status          String   @default("active")
  createdAt       DateTime @default(now())

  negotiation Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  messages    WhatsAppMessage[]

  @@index([providerNumber])
}

model WhatsAppMessage {
  id              String   @id @default(cuid())
  threadId        String
  direction       String              // "inbound" | "outbound"
  body            String   @db.Text
  mediaUrl        String?
  // AI counter-draft awaiting user confirm. False = real message sent/received.
  pendingApproval Boolean  @default(false)
  receivedAt      DateTime @default(now())

  thread WhatsAppThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

model NegotiationRound {
  id               String       @id @default(cuid())
  negotiationId    String
  roundNumber      Int
  providerResponse String?      @db.Text
  responseOcrText  String?      @db.Text
  analysisJson     String?      @db.Text
  offeredCents     Int?
  counterSubject   String?
  counterBody      String?      @db.Text
  outcome          RoundOutcome @default(PENDING)
  // v10 auto-pingpong: optional inbound-Resend metadata + confirm-send
  // bookkeeping. confirmedSentAt is set when the user clicks "Verstuur
  // counter via DeGeldHeld" en de mail daadwerkelijk via Resend gaat.
  inboundMessageId String?
  inboundReplyTo   String?
  confirmedSentAt  DateTime?
  createdAt        DateTime     @default(now())

  negotiation Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)

  @@unique([negotiationId, roundNumber])
  @@index([negotiationId])
}

// v11 anti-fraud: scored flag van een suspicieus account. Admin
// review-panel toont openstaande flags, kan unflag of suspend.
model FraudFlag {
  id        String   @id @default(cuid())
  userId    String
  score     Int
  reasons   String   @db.Text
  resolved  Boolean  @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resolved, createdAt])
}

// v11 revenue verification: bewijsstuk dat de user daadwerkelijk
// bespaard heeft. Zonder verified proof: state = SUCCESS_UNVERIFIED,
// telt niet mee voor /proof aggregates en triggert geen fee.
model OutcomeProof {
  id                 String    @id @default(cuid())
  negotiationId      String
  kind               String    // "forwarded_email" | "new_bill" | "screenshot" | "manual"
  storageUrl         String?
  parsedAmountCents  Int?
  verifiedAt         DateTime?
  verificationStatus String    @default("pending") // pending | verified | rejected | manual_review
  verifierNote       String?   @db.Text
  createdAt          DateTime  @default(now())

  negotiation Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)

  @@index([negotiationId])
  @@index([verificationStatus])
}

model Payment {
  id                  String        @id @default(cuid())
  userId              String
  negotiationId       String        @unique
  stripeSessionId     String?       @unique
  stripePaymentId     String?
  // v18: audit-trail of the last Stripe event that mutated this row.
  stripeEventId       String?
  amountCents         Int
  status              PaymentStatus @default(PENDING)
  refundedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  negotiation Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// v18: idempotency guard for the Stripe webhook. Stripe retries
// events aggressively; recording each processed event id lets us
// skip duplicates so we never double-charge / double-flip state.
model ProcessedStripeEvent {
  id          String   @id          // the Stripe event.id (evt_...)
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  userId    String?  @unique
  source    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
}

// v8 OCR fine-tune dataset
model OcrTrainingSample {
  id              String   @id @default(cuid())
  userId          String?
  imageStorageUrl String?              // Vercel Blob URL (null = text-only)
  anonymizedJson  String   @db.Text    // ground-truth labels, PII-stripped
  reviewed        Boolean  @default(false)
  reviewerUserId  String?
  billCategory    String
  country         String
  createdAt       DateTime @default(now())

  @@index([reviewed])
  @@index([billCategory])
}

// v9 cron-lock — prevent duplicate runs (Vercel can fire same cron twice
// during rolling deploys; one wins via unique(jobName,runDate)).
model CronRunLog {
  id             String    @id @default(cuid())
  jobName        String                 // 'outcome-followup' | 'monthly-recheck' | 'psd2-sync' | 'follow-up'
  runDate        String                 // YYYY-MM-DD (UTC)
  status         String    @default("running")  // running | done | failed
  itemsProcessed Int       @default(0)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  @@unique([jobName, runDate])
  @@index([jobName, startedAt])
}

model MarketProvider {
  id         String       @id @default(cuid())
  name       String       @unique
  category   BillCategory
  // Tarief per maand in cents voor instap-pakket (laagste plan).
  basePriceCents Int
  url        String?
  notes      String?
  updatedAt  DateTime     @updatedAt

  plans MarketPlan[]

  @@index([category])
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProviderCandidate {
  id            String          @id @default(cuid())
  name          String
  country       String
  retentionJson String          @db.Text
  status        CandidateStatus @default(PENDING)
  source        String?         // bv "user_upload" / "admin"
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([name, country])
  @@index([status])
}

// v8 PSD2 — bank-connection via Tink Open Banking
model BankConnection {
  id              String    @id @default(cuid())
  userId          String
  bankName        String
  accessTokenEnc  String    @db.Text
  refreshTokenEnc String?   @db.Text
  expiresAt       DateTime
  lastSyncAt      DateTime?
  status          String    @default("active")  // active | revoked | expired
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Detected recurring debit not yet converted to a Bill — shown on /account/banks
model DetectedRecurring {
  id              String    @id @default(cuid())
  userId          String
  bankConnectionId String?
  counterpartyName String
  monthlyCents    Int
  category        String    @default("OVERIG")
  lastSeenAt      DateTime
  occurrences     Int       @default(2)
  convertedBillId String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, convertedBillId])
}

model Referral {
  id          String    @id @default(cuid())
  code        String    @unique          // 6-letter slug
  ownerId     String
  usedById    String?
  usedAt      DateTime?
  rewardCents Int?
  createdAt   DateTime  @default(now())

  owner User @relation("ReferralOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([code])
}

model MarketPlan {
  id          String       @id @default(cuid())
  providerId  String
  name        String
  category    BillCategory
  priceCents  Int
  features    String?      @db.Text
  updatedAt   DateTime     @updatedAt

  provider MarketProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([category, priceCents])
}

// ─────────────────────────────────────────────────────────────
// v30 — Box 3 proof-back NCNP-loop (Box3Claim) + Plus monthly rescans (PlusRescan)
//
// AVG-grondslag voor Box3Claim + uploaded beschikking: noodzakelijk voor de
// uitvoering van de overeenkomst (no-cure-no-pay-fee). Privacy-pagina vermeldt
// dit expliciet als sub-processor-aansprakelijke verwerking. Zie V30_REPORT.md.
// ─────────────────────────────────────────────────────────────

model Box3Claim {
  id                       String   @id @default(cuid())
  userId                   String
  jaar                     Int
  verwachteTeruggaveCents  Int
  /// INTENT | AWAITING_PROOF | PROOF_RECEIVED | CHARGED | FAILED
  status                   String
  werkelijkTeruggaveCents  Int?
  /// URL to uploaded Belastingdienst-beschikking (Vercel Blob / Resend / etc).
  proofStorageUrl          String?
  proofUploadedAt          DateTime?
  chargedAt                DateTime?
  feeCents                 Int?
  stripePaymentIntentId    String?
  /// Reason on FAILED (OCR couldn't read, manual review needed).
  failureReason            String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
}

model PlusRescan {
  id           String   @id @default(cuid())
  userId       String
  runAt        DateTime @default(now())
  /// JSON-shape: { nieuw: Finding[], gewijzigd: Finding[], verdwenen: Finding[] }
  /// — see lib/plus-rescan.ts for the canonical shape.
  findingsJson Json
  /// Set when a notification mail was sent for this rescan.
  notifiedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, runAt])
}

// ──────────────────────────────────────────────────────────────────
// v35 Claim-Hub uitbreiding — parallel aan Box3Claim, géén refactor.
// Beide flows lopen via officiële instanties (Huurcommissie /
// Geschillencommissie Energie) — geen provider-relay-mail, dus
// onafhankelijk van het KPN-test-verdict. AVG-grondslag voor opslag:
// art. 6 lid 1b (uitvoering NCNP-overeenkomst). V36 mogelijk
// unificatie tot één Claim-abstractie; eerst beide types proof.
// ──────────────────────────────────────────────────────────────────

model HuurServicekostenClaim {
  id                       String   @id @default(cuid())
  userId                   String
  boekjaar                 Int
  verhuurderNaam           String?
  verwachteRestitutieCents Int
  /// INTENT | BEZWAAR_GESTUURD | HUURCOMMISSIE_INGEDIEND | UITSPRAAK | CHARGED | FAILED
  status                   String
  werkelijkeRestitutieCents Int?
  /// URL to uploaded Huurcommissie-uitspraak (Vercel Blob / Resend).
  uitspraakStorageUrl      String?
  uitspraakUploadedAt      DateTime?
  chargedAt                DateTime?
  feeCents                 Int?
  stripePaymentIntentId    String?
  failureReason            String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
}

model EnergieEindafrekeningClaim {
  id                       String   @id @default(cuid())
  userId                   String
  provider                 String
  verwachteRestitutieCents Int
  /// INTENT | KLACHT_GESTUURD | GESCHILLENCOMMISSIE_INGEDIEND | UITSPRAAK | CHARGED | FAILED
  status                   String
  werkelijkeRestitutieCents Int?
  uitspraakStorageUrl      String?
  uitspraakUploadedAt      DateTime?
  chargedAt                DateTime?
  feeCents                 Int?
  stripePaymentIntentId    String?
  failureReason            String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
}

// ──────────────────────────────────────────────────────────────────
// v36 Basis-versterking: admin audit + Stripe webhook audit.
// ──────────────────────────────────────────────────────────────────

/// v36 — audit-log van elke handmatige owner-actie via /admin/*.
/// Wie heeft welk record op welk moment veranderd? Bewaartermijn 7 jaar
/// (financiële administratie). Géén PII anders dan adminEmail (zelf-input
/// in ADMIN_EMAILS env; niet de eindgebruiker).
model AdminAction {
  id              String   @id @default(cuid())
  adminEmail      String
  /// charge-box3 | charge-huur | charge-energie | reverse-charge | other
  action          String
  /// Box3Claim | HuurServicekostenClaim | EnergieEindafrekeningClaim
  targetType      String
  targetId        String
  /// Detail-payload JSON: { feeCents, paymentIntentId?, reason?, ... }
  payloadJson     Json
  ok              Boolean
  errorMessage    String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([adminEmail, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

/// v36 — audit-trail per inkomende Stripe-webhook. ProcessedStripeEvent
/// is de snelle idempotency-lock (uniek event-id, write-or-skip).
/// StripeWebhookEvent slaat aanvullende debug-info op: parse-status,
/// handler-uitkomst, foutmelding indien faal. Owner kan zo precies zien
/// of een event ooit binnenkwam en hoe het verliep — los van Stripe-dashboard.
model StripeWebhookEvent {
  id              String   @id @default(cuid())
  stripeEventId   String   @unique
  type            String
  receivedAt      DateTime @default(now())
  /// "duplicate" | "ok" | "handler-failed" | "signature-failed"
  outcome         String
  /// Hash van de payload (sha256, 64 chars) zodat we kunnen detecteren of
  /// een retry exact dezelfde payload had. Géén opslag van de payload zelf
  /// (kan PII bevatten in metadata).
  payloadHash     String
  /// Handler-uitkomst-velden (negotiationId / billId / claimId, ...).
  resolvedRef     String?
  errorMessage    String?  @db.Text

  @@index([stripeEventId])
  @@index([type, receivedAt])
  @@index([outcome, receivedAt])
}

// ──────────────────────────────────────────────────────────────────
// v36 idee 4 — Document-vault.
// ──────────────────────────────────────────────────────────────────

/// Eén keer een huurcontract / energiecontract / loonstrook / aangifte /
/// beschikking uploaden, hergebruiken in elke check of claim. Opslag via
/// Vercel Blob (random-suffix URL; binnen sessie alleen owner ziet het via
/// auth-gated /account/documents-page).
///
/// Bewaartermijn: tot account-deletion (AVG art. 17) of, voor fiscaal-
/// relevante stukken (aangifte/beschikking), tot 7 jaar — gebruiker kan
/// elk document zelf direct verwijderen via DELETE /api/account/documents/[id].
model UserDocument {
  id          String   @id @default(cuid())
  userId      String
  /// Categorie: huurcontract | energiecontract | loonstrook | aangifte |
  /// beschikking | jaarafrekening | overig
  kind        String
  /// Originele bestandsnaam zoals de user hem upload'de (voor weergave).
  filename    String
  /// Bestandsgrootte in bytes (max 10 MB enforced in upload-route).
  sizeBytes   Int
  /// MIME-type (validation in upload-route: application/pdf | image/png | image/jpeg).
  mimeType    String
  /// Vercel Blob URL (random-suffix → niet te raden). UI toont 'm alleen
  /// achter auth-gate /account/documents.
  storageUrl  String   @db.Text
  /// Optionele toelichting van de user ("2024 aangifte definitief").
  note        String?  @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, kind])
}
